#:kivy 2.3.0
#:import theme theme
#:import GradientBG theme.GradientBG

# ---------- reusable glass panels ----------

<GlassBox@BoxLayout>:
    canvas.before:
        Color:
            rgba: 0, 0, 0, 0.30
        RoundedRectangle:
            pos: self.x, self.y - 3
            size: self.size[0], self.size[1] + 6
            radius: [32]
        Color:
            rgba: 1, 1, 1, 0.10
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [32]
        Color:
            rgba: 1, 1, 1, 0.32
        Line:
            rounded_rectangle: self.x, self.y, self.width, self.height, 32, 32, 32, 32
            width: 1.0

# ---------- reusable glass buttons ----------

<ACTION@Button>:
    background_normal: ''
    background_down: ''
    background_color: 1, 1, 1, 0.13
    color: 1, 1, 1, 1
    bold: True
    font_size: '16sp'
    canvas.before:
        Color:
            rgba: 0, 0, 0, 0.30
        RoundedRectangle:
            pos: self.x, self.y - 2
            size: self.size
            radius: [26]
        Color:
            rgba: (1, 1, 1, 0.24) if self.state == 'down' else self.background_color
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [26]
        Color:
            rgba: 1, 1, 1, 0.32
        Line:
            rounded_rectangle: self.x, self.y, self.width, self.height, 26, 26, 26, 26
            width: 1.0

<ToggleAction@ToggleButton>:
    background_normal: ''
    background_down: ''
    background_color: 1, 1, 1, 0.13
    color: 1, 1, 1, 1
    bold: True
    font_size: '16sp'
    canvas.before:
        Color:
            rgba: 0, 0, 0, 0.30
        RoundedRectangle:
            pos: self.x, self.y - 2
            size: self.size
            radius: [26]
        Color:
            rgba: (0.30, 0.92, 0.52, 0.38) if self.state == 'down' else (1, 1, 1, 0.13)
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [26]
        Color:
            rgba: (0.30, 0.92, 0.52, 0.58) if self.state == 'down' else (1, 1, 1, 0.32)
        Line:
            rounded_rectangle: self.x, self.y, self.width, self.height, 26, 26, 26, 26
            width: 1.0

<ACTION_DANGER@Button>:
    background_normal: ''
    background_down: ''
    background_color: 1.0, 0.25, 0.32, 0.30
    color: 1, 1, 1, 1
    bold: True
    font_size: '14sp'
    canvas.before:
        Color:
            rgba: 0, 0, 0, 0.30
        RoundedRectangle:
            pos: self.x, self.y - 2
            size: self.size
            radius: [22]
        Color:
            rgba: (1.0, 0.25, 0.32, 0.50) if self.state == 'down' else self.background_color
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [22]
        Color:
            rgba: 1.0, 0.25, 0.32, 0.50
        Line:
            rounded_rectangle: self.x, self.y, self.width, self.height, 22, 22, 22, 22
            width: 1.0

<GLASS_ACTION@Button>:
    background_normal: ''
    background_down: ''
    background_color: 1, 1, 1, 0.13
    color: 1, 1, 1, 1
    bold: True
    font_size: '14sp'
    canvas.before:
        Color:
            rgba: 0, 0, 0, 0.28
        RoundedRectangle:
            pos: self.x, self.y - 2
            size: self.size
            radius: [22]
        Color:
            rgba: (1, 1, 1, 0.24) if self.state == 'down' else self.background_color
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [22]
        Color:
            rgba: 1, 1, 1, 0.30
        Line:
            rounded_rectangle: self.x, self.y, self.width, self.height, 22, 22, 22, 22
            width: 0.8

# ---------- text reader popup (glass modal) ----------

<TextReaderPopup@Popup>:
    title: ''
    separator_height: 0
    auto_dismiss: True
    size_hint: 0.92, 0.86
    background: ''
    background_color: 0, 0, 0, 0
    overlay_color: 0, 0, 0, 0.55
    canvas.before:
        Color:
            rgba: 0, 0, 0, 0.30
        RoundedRectangle:
            pos: self.x, self.y - 4
            size: self.size[0], self.size[1] + 8
            radius: [34]
        Color:
            rgba: 1, 1, 1, 0.11
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [34]
        Color:
            rgba: 1, 1, 1, 0.34
        Line:
            rounded_rectangle: self.x, self.y, self.width, self.height, 34, 34, 34, 34
            width: 1.2
    BoxLayout:
        orientation: 'vertical'
        padding: 22
        spacing: 14
        Label:
            id: sheet_title
            text: 'Screen Text'
            font_size: '21sp'
            bold: True
            color: 1, 1, 1, 1
            size_hint_y: None
            height: 34
            halign: 'center'
            valign: 'middle'
            text_size: self.size
        TextInput:
            id: text_view
            font_size: '17sp'
            background_color: 1, 1, 1, 0.07
            foreground_color: 1, 1, 1, 1
            cursor_color: 0.30, 0.92, 0.95, 1
            selection_color: 0.30, 0.92, 0.95, 0.45
            hint_text_color: 1, 1, 1, 0.45
            hint_text: 'Text will appear here...'
            padding: [14, 14, 14, 14]
            size_hint_y: 1
            multiline: True
            readonly: False
        BoxLayout:
            size_hint_y: None
            height: '48dp'
            spacing: 10
            GLASS_ACTION:
                text: 'Speak'
                on_release: app.popup_speak(root)
            GLASS_ACTION:
                text: 'Speak Selected'
                on_release: app.popup_speak_selected(root)
            GLASS_ACTION:
                text: 'Copy'
                on_release: app.popup_copy(root)
            ACTION_DANGER:
                text: 'Done'
                on_release: root.dismiss()

# ---------- camera layer ----------

<CameraPreview>:
    canvas.before:
        Color:
            rgba: 0, 0, 0, 1
        Rectangle:
            pos: self.pos
            size: self.size

# ==========================================================
# Root layout — full-bleed camera with floating glass panels
# ==========================================================

FloatLayout:

    # gradient background (visible behind camera / on desktop before feed starts)
    GradientBG:
        top_color: 0.06, 0.40, 0.78, 1.0
        bottom_color: 0.05, 0.85, 0.70, 1.0
        pos_hint: {'center_x': 0.5, 'center_y': 0.5}
        size_hint: 1, 1

    # camera fills the screen
    CameraPreview:
        id: preview
        pos_hint: {'center_x': 0.5, 'center_y': 0.5}
        size_hint: 1, 1

    # ---- status capsule (top) ----
    GlassBox:
        pos_hint: {'center_x': 0.5, 'center_y': 0.925}
        size_hint: 0.88, None
        height: '50dp'
    Label:
        id: status
        pos_hint: {'center_x': 0.5, 'center_y': 0.925}
        size_hint: 0.84, None
        height: '44dp'
        text: 'Ready. Say a command or tap a button.'
        font_size: '16sp'
        bold: True
        color: 1, 1, 1, 1
        halign: 'center'
        valign: 'middle'
        shorten: True
        shorten_from: 'right'
        text_size: self.size

    # ---- desktop command row (hidden on Android) ----
    GlassBox:
        id: command_row
        pos_hint: {'center_x': 0.5, 'center_y': 0.80}
        size_hint: 0.88, None
        height: '50dp'
        spacing: 6
        padding: [5, 4]
        TextInput:
            id: command_input
            hint_text: 'Type a command, e.g. "what is in front"'
            font_size: '15sp'
            multiline: False
            background_color: 1, 1, 1, 0.06
            foreground_color: 1, 1, 1, 1
            cursor_color: 0.30, 0.92, 0.95, 1
            hint_text_color: 1, 1, 1, 0.45
            padding: [12, 10, 12, 10]
            on_text_validate: app.submit_command_text()
        GLASS_ACTION:
            id: listen
            text: 'Listen'
            bold: True
            size_hint_x: None
            width: '88dp'
            on_state: app.toggle_listen(self.state)

    # ---- controls card (bottom) ----
    GlassBox:
        id: controls_panel
        orientation: 'vertical'
        pos_hint: {'center_x': 0.5, 'center_y': 0.22}
        size_hint: 0.94, None
        height: '320dp'
        padding: [14, 12]
        GridLayout:
            cols: 2
            spacing: 10
            size_hint_y: 1
            ACTION:
                text: 'What is in front'
                on_release: app.act_scene()
            ACTION:
                text: 'Read screen'
                on_release: app.act_read_screen()
            ACTION:
                text: 'What color'
                on_release: app.act_color()
            ACTION:
                text: 'Scan product'
                on_release: app.act_scanner()
            ACTION:
                text: 'Read text'
                on_release: app.act_ocr()
            ACTION:
                text: 'Navigate'
                on_release: app.act_navigate()
            ToggleAction:
                id: continuous
                text: 'Continuous'
                on_state: app.toggle_continuous(self.state)
            ACTION:
                text: 'Clipboard'
                on_release: app.act_clipboard()
        BoxLayout:
            size_hint_y: None
            height: '44dp'
            spacing: 8
            ACTION_DANGER:
                text: 'Pause'
                on_release: app.act_stop()
            GLASS_ACTION:
                text: 'Repeat'
                on_release: app.act_repeat()
            GLASS_ACTION:
                text: 'Help'
                on_release: app.act_help()
            GLASS_ACTION:
                text: 'Paste Text'
                on_release: app.open_text_input_sheet()